# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
DEVICE_NAME = ENV["DEVICE_NAME"]
DEVICE_ID = ENV["DEVICE_ID"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

platform :ios do
  desc "Build Loop"
  lane :build_loop do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    update_project_team(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      teamid: "#{TEAMID}"
    )

    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    previous_build_number = latest_testflight_build_number(
      app_identifier: "com.#{TEAMID}.loopkit.Loop",
      api_key: api_key,
    )

    current_build_number = previous_build_number + 1

    increment_build_number(
      xcodeproj: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      build_number: current_build_number
    )      
    
    match(
      type: "appstore",
      readonly: false,
      force: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        "com.#{TEAMID}.loopkit.Loop", 
        "com.#{TEAMID}.loopkit.Loop.statuswidget", 
        "com.#{TEAMID}.loopkit.Loop.LoopWatch.watchkitextension", 
        "com.#{TEAMID}.loopkit.Loop.LoopWatch", 
        "com.#{TEAMID}.loopkit.Loop.Loop-Intent-Extension",
        "com.#{TEAMID}.loopkit.Loop.LoopWidgetExtension"
      ]
    )

    mapping = Actions.lane_context[
      SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
    ]

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Loop"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      code_sign_identity: "iPhone Distribution",
      targets: ["LoopCore", "LoopCore-watchOS", "LoopUI"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop.statuswidget"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Loop Status Extension"]
    )
    
    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop.LoopWatch.watchkitextension"],
      code_sign_identity: "iPhone Distribution",
      targets: ["WatchApp Extension"]
    )
    
    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop.LoopWatch"],
      code_sign_identity: "iPhone Distribution",
      targets: ["WatchApp"]
    )
    
    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop.Loop-Intent-Extension"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Loop Intent Extension"]
    )
    
    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Loop/Loop.xcodeproj",
      profile_name: mapping["com.#{TEAMID}.loopkit.Loop.LoopWidgetExtension"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Loop Widget Extension"]
    )

    # Patch PluginManager to support embedded pump drivers
    patch_plugin_manager

    gym(
      export_method: "app-store",
      scheme: "LoopWorkspace",
      output_name: "Loop.ipa",
      configuration: "Release",
      destination: 'generic/platform=iOS',
      buildlog_path: 'buildlog'
    )

    # Embed pump driver frameworks (ApexKitBLE and EmbectaKitBLE)
    embed_pump_frameworks

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )
  end

  desc "Patch PluginManager.swift to support embedded pump drivers"
  lane :patch_plugin_manager do
    # Ensure Loop submodule is properly initialized and synced
    Dir.chdir(GITHUB_WORKSPACE) do
      # Sync submodule configuration
      sh "git submodule sync --recursive 2>/dev/null || true"
      # Force update the Loop submodule
      sh "git submodule update --init --force Loop"
    end
    
    plugin_manager_path = "#{GITHUB_WORKSPACE}/Loop/Plugins/PluginManager.swift"
    
    unless File.exist?(plugin_manager_path)
      puts "PluginManager.swift not found at #{plugin_manager_path}, skipping patch"
      # List what's in Loop directory for debugging
      if File.directory?("#{GITHUB_WORKSPACE}/Loop")
        puts "Loop directory contents: #{Dir.glob("#{GITHUB_WORKSPACE}/Loop/**/*").first(10).join(', ')}"
      else
        puts "Loop directory does not exist"
      end
      next
    end
    
    content = File.read(plugin_manager_path)
    
    # 1. Replace fatalError("PrincipalClass does not conform to PumpManagerUIPlugin") with fallback
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to PumpManagerUIPlugin")',
      'log.error("PrincipalClass does not conform to PumpManagerUIPlugin, trying direct class lookup"); if let className = bundle.object(forInfoDictionaryKey: "LoopPluginPumpManagerClassName") as? String, let cls = NSClassFromString(className) as? PumpManagerUI.Type { log.info("Direct class resolution succeeded: %{public}@", className); return cls }; log.error("Direct class resolution also failed for identifier: %{public}@", name); return nil'
    )
    
    # 2. Replace fatalError("PrincipalClass not found") with fallback
    content = content.gsub(
      'fatalError("PrincipalClass not found")',
      'log.error("PrincipalClass not found, trying direct class lookup"); if let className = bundle.object(forInfoDictionaryKey: "LoopPluginPumpManagerClassName") as? String, let cls = NSClassFromString(className) as? PumpManagerUI.Type { log.info("Direct class resolution succeeded: %{public}@", className); return cls }; log.error("Direct class resolution also failed"); return nil'
    )
    
    # 3. Similarly patch CGM, Service, StatefulPlugin, Onboarding, Support fatalError calls
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to CGMManagerUIPlugin")',
      'log.error("PrincipalClass does not conform to CGMManagerUIPlugin"); return nil'
    )
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to ServiceUIPlugin")',
      'log.error("PrincipalClass does not conform to ServiceUIPlugin"); return nil'
    )
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to StatefulPlugin")',
      'log.error("PrincipalClass does not conform to StatefulPlugin"); return nil'
    )
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to OnboardingUIPlugin")',
      'log.error("PrincipalClass does not conform to OnboardingUIPlugin"); return nil'
    )
    content = content.gsub(
      'fatalError("PrincipalClass does not conform to SupportUIPlugin")',
      'log.error("PrincipalClass does not conform to SupportUIPlugin"); return nil'
    )
    
    File.write(plugin_manager_path, content)
    puts "Patched PluginManager.swift - replaced fatalError with graceful fallback"
  end

    desc "Embed Pump Driver Frameworks into Loop.app"
  lane :embed_pump_frameworks do
    # Define source framework paths - ONLY main BLE frameworks (not empty Plugin shells)
    frameworks = [
      {
        name: "ApexKitBLE",
        main_path: "#{GITHUB_WORKSPACE}/ApexKitBLE/ApexKitBLE",
        pump_manager_class: "ApexKitBLE.ApexKitPumpManager",
        identifier: "Apex",
        display_name: "Apex"
      },
      {
        name: "EmbectaKitBLE",
        main_path: "#{GITHUB_WORKSPACE}/EmbectaKitBLE/EmbectaKitBLE",
        pump_manager_class: "EmbectaKitBLE.EmbectaKitPumpManager",
        identifier: "Embecta",
        display_name: "Embecta"
      }
    ]

    # Check if any pump driver frameworks exist
    has_frameworks = frameworks.any? { |fw| File.directory?(fw[:main_path]) }

    unless has_frameworks
      puts "No pump driver frameworks found. Skipping embedding."
      next
    end

    puts "Found pump driver frameworks. Embedding into Loop.app..."

    # Create temp directory for IPA manipulation
    temp_dir = "#{GITHUB_WORKSPACE}/temp_ipa"
    FileUtils.rm_rf(temp_dir)
    FileUtils.mkdir_p(temp_dir)

    # Unzip the IPA
    ipa_path = "#{GITHUB_WORKSPACE}/Loop.ipa"
    sh "unzip -q #{ipa_path} -d #{temp_dir}"

    # Path to the app bundle
    app_path = Dir.glob("#{temp_dir}/Payload/*.app").first
    frameworks_dest = "#{app_path}/Frameworks"
    FileUtils.mkdir_p(frameworks_dest)

    # Get the signing identity
    signing_identity = "Apple Distribution"
    cert_info = `security find-identity -v -p codesigning 2>/dev/null | grep -i distribution | head -1`.strip
    if cert_info.include?('"')
      signing_identity = cert_info.match(/"(.+)"/)[1]
      puts "Found signing identity: #{signing_identity}"
    end

    # Embed ONLY main BLE frameworks (NOT Plugin frameworks - they are empty shells)
    frameworks.each do |fw|
      if File.directory?(fw[:main_path])
        puts "Processing #{fw[:name]}..."

        fw_bundle = "#{frameworks_dest}/#{fw[:name]}.framework"
        FileUtils.mkdir_p(fw_bundle)
        FileUtils.cp_r(Dir.glob("#{fw[:main_path]}/*"), fw_bundle)
        
        # Remove original signature
        sh "codesign --remove-signature '#{fw_bundle}' 2>/dev/null || true"
        sh "codesign --remove-signature '#{fw_bundle}/#{fw[:name]}' 2>/dev/null || true"
        
        # Add PumpManagerIdentifier to Info.plist so PluginManager can discover it
        info_plist = "#{fw_bundle}/Info.plist"
        sh "/usr/libexec/PlistBuddy -c 'Add :com.loopkit.Loop.PumpManagerIdentifier string #{fw[:identifier]}' '#{info_plist}' 2>/dev/null || /usr/libexec/PlistBuddy -c 'Set :com.loopkit.Loop.PumpManagerIdentifier #{fw[:identifier]}' '#{info_plist}'"
        sh "/usr/libexec/PlistBuddy -c 'Add :com.loopkit.Loop.PumpManagerDisplayName string #{fw[:display_name]}' '#{info_plist}' 2>/dev/null || /usr/libexec/PlistBuddy -c 'Set :com.loopkit.Loop.PumpManagerDisplayName #{fw[:display_name]}' '#{info_plist}'"
        
        # Add custom key for direct class resolution
        sh "/usr/libexec/PlistBuddy -c 'Add :LoopPluginPumpManagerClassName string #{fw[:pump_manager_class]}' '#{info_plist}' 2>/dev/null || /usr/libexec/PlistBuddy -c 'Set :LoopPluginPumpManagerClassName #{fw[:pump_manager_class]}' '#{info_plist}'"
        
        # Sign the framework
        sh "codesign --force --sign '#{signing_identity}' '#{fw_bundle}'"
        
        puts "Embedded #{fw[:name]}.framework with PumpManagerIdentifier=#{fw[:identifier]}"
      end
    end

    # Re-sign the app
    profile_path = "#{app_path}/embedded.mobileprovision"
    if File.exist?(profile_path)
      profile_plist = "#{temp_dir}/profile.plist"
      sh "security cms -D -i '#{profile_path}' > '#{profile_plist}'"
      entitlements_path = "#{temp_dir}/app_entitlements.plist"
      sh "/usr/libexec/PlistBuddy -x -c 'Print Entitlements' '#{profile_plist}' > '#{entitlements_path}'"
      nfc_entitlement = `/usr/libexec/PlistBuddy -c 'Print com.apple.developer.nfc.readersession.formats' '#{entitlements_path}' 2>/dev/null`.strip
      if nfc_entitlement.include?('NDEF')
        sh "/usr/libexec/PlistBuddy -c 'Delete com.apple.developer.nfc.readersession.formats:0' '#{entitlements_path}' 2>/dev/null || true"
      end
      sh "codesign --force --sign '#{signing_identity}' --entitlements '#{entitlements_path}' '#{app_path}'"
    else
      sh "codesign --force --sign '#{signing_identity}' '#{app_path}'"
    end

    # Repackage IPA
    FileUtils.rm_f("#{temp_dir}/app_entitlements.plist")
    FileUtils.rm_f("#{temp_dir}/profile.plist")
    FileUtils.rm_f(ipa_path)
    Dir.chdir(temp_dir) do
      all_items = Dir.glob("*").reject { |f| f.start_with?(".") }
      sh "zip -qr #{ipa_path} #{all_items.join(' ')}"
    end
    FileUtils.rm_rf(temp_dir)
    puts "Successfully embedded pump driver frameworks and re-signed the IPA"
  end

  desc "Push to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: "Loop.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Provision Identifiers and Certificates"
  lane :identifiers do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name:       name,
        identifier: identifier,
        platform:   "IOS"
      )
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |c| existing.include?(c) }.each do |cap|
        bundle_id.create_capability(cap)
      end
    end

    configure_bundle_id("Loop", "com.#{TEAMID}.loopkit.Loop", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT,
      Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::SIRIKIT,
      Spaceship::ConnectAPI::BundleIdCapability::Type::NFC_TAG_READING
    ])

    configure_bundle_id("Loop Intent Extension", "com.#{TEAMID}.loopkit.Loop.Loop-Intent-Extension", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])

    configure_bundle_id("Loop Status Extension", "com.#{TEAMID}.loopkit.Loop.statuswidget", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])

    configure_bundle_id("WatchApp", "com.#{TEAMID}.loopkit.Loop.LoopWatch", [])

    configure_bundle_id("WatchApp Extension", "com.#{TEAMID}.loopkit.Loop.LoopWatch.watchkitextension", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT,
      Spaceship::ConnectAPI::BundleIdCapability::Type::SIRIKIT
    ])

    configure_bundle_id("Loop Widget Extension", "com.#{TEAMID}.loopkit.Loop.LoopWidgetExtension", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])
    
  end

  desc "Provision Certificates"
  lane :certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        "com.#{TEAMID}.loopkit.Loop", 
        "com.#{TEAMID}.loopkit.Loop.statuswidget", 
        "com.#{TEAMID}.loopkit.Loop.LoopWatch.watchkitextension", 
        "com.#{TEAMID}.loopkit.Loop.LoopWatch", 
        "com.#{TEAMID}.loopkit.Loop.Loop-Intent-Extension",
        "com.#{TEAMID}.loopkit.Loop.LoopWidgetExtension",
      ]
    )
  end

  desc "Validate Secrets"
  lane :validate_secrets do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    def find_bundle_id(identifier)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
    end

    find_bundle_id("com.#{TEAMID}.loopkit.Loop")

    match(
      type: "appstore",
      readonly: false,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [],
    )

  end
  
  desc "Nuke Certs"
  lane :nuke_certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    match_nuke(
      type: "appstore",
      team_id: "#{TEAMID}",
      skip_confirmation: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
    )
  end

  desc "Check Certificates and Trigger Workflow for Expired or Missing Certificates"
  lane :check_and_renew_certificates do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s

    # Authenticate using App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_content: ENV["FASTLANE_KEY"] # Ensure valid valid key content
    )

    # Initialize flag to track if renewal of certificates is needed
    new_certificate_needed = false

    # Fetch all certificates
    certificates = Spaceship::ConnectAPI::Certificate.all

    # Filter for Distribution Certificates
    distribution_certs = certificates.select { |cert| cert.certificate_type == "DISTRIBUTION" }

    # Handle case where no distribution certificates are found
    if distribution_certs.empty?
      puts "No Distribution certificates found! Triggering action to create certificate."
      new_certificate_needed = true
    else
      # Check for expiration
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)

        puts "Current Distribution Certificate: #{cert.id}, Expiration date: #{expiration_date}"

        if expiration_date < Time.now
          puts "Distribution Certificate #{cert.id} is expired! Triggering action to renew certificate."
          new_certificate_needed = true
        else
          puts "Distribution certificate #{cert.id} is valid. No action required."
        end
      end
    end

    # Write result to new_certificate_needed.txt
    file_path = File.expand_path('new_certificate_needed.txt')
    File.write(file_path, new_certificate_needed ? 'true' : 'false')  

    # Log the absolute path and contents of the new_certificate_needed.txt file
    puts ""
    puts "Absolute path of new_certificate_needed.txt: #{file_path}"
    new_certificate_needed_content = File.read(file_path)
    puts "Certificate creation or renewal needed: #{new_certificate_needed_content}"
  end
end
